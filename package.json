		"eslint-plugin-obsidianmd": "^0.5.1",
		"globals": "^17.14.0",
		"jiti": "2.7.0",
		"tslib": "^2.9.1",
		"typescript": ">=6 <6.1",
		"typescript-eslint": "^8.72.2",
		"vitest": "^5.1.0"
	},
	"peerDependencies": {
		"@codemirror/state": "^6",
		"@codemirror/view": "^6"
	},
	"overrides": {
